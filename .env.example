# ============================================================================
# KONFIGURASI BACKEND - Aplikasi Absensi PKL (Supabase PostgreSQL)
# ============================================================================

# ----- Supabase PostgreSQL -----
# Ambil URI dari Supabase Dashboard > Connect > Session pooler/Transaction pooler.
# Jangan masukkan anon key atau service_role key ke source code.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?sslmode=require
DB_POOL_MAX=10

# ----- JWT -----
# Generate random string minimal 32 karakter
# Contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters

# ----- Server -----
PORT=5000
NODE_ENV=development

# ----- Development helpers -----
# Set true untuk bypass validasi WiFi (uji di localhost)
BYPASS_WIFI_CHECK=true

# Opsional, set true untuk bypass aturan jam absen / jeda
# BYPASS_TIME_CHECK=true
# BYPASS_PAGI_ONLY=true
# BYPASS_JEDA_CHECK=true

# ----- Upload folder (opsional) -----
# Lokasi default: server/uploads/
# UPLOAD_ROOT=uploads
