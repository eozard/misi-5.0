# ============================================================================
# KONFIGURASI BACKEND - Aplikasi Absensi PKL (XAMPP MySQL)
# ============================================================================

# ----- Koneksi MySQL (XAMPP default) -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pkl

# ----- JWT -----
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters

# ----- Server -----
PORT=5000
NODE_ENV=development

# ----- Development helpers -----
BYPASS_WIFI_CHECK=true

# BYPASS_TIME_CHECK=true
# BYPASS_PAGI_ONLY=true
# BYPASS_JEDA_CHECK=true

# ----- Upload folder -----
# UPLOAD_ROOT=uploads
